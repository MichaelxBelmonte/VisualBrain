{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Brain",
  "version": "0.2.62",
  "identifier": "com.jethr.visualbrain",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Visual Brain",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": { "effects": ["liquidGlassRegular", "sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../runtime/": "runtime/"
    }
  }
}
